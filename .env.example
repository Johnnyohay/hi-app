# Copy this file to .env, then fill in the values from your Supabase project
# dashboard: Project Settings → API. See the setup steps shared alongside
# this file for how to create the project.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# From your Mapbox account (account.mapbox.com) — used for city typeahead.
# This is a public token by design, safe to ship in the client.
EXPO_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token
